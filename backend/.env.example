# Where the SQLite file lives. Default: ./data/app.db (relative to backend/).
# The app reads the DATABASE_URL environment variable; it does not load this file by itself.
DATABASE_URL=sqlite:///./data/app.db

# The page addresses (comma separated) that may call the API from a browser.
# Default: the local dev server, http://localhost:5173 and http://127.0.0.1:5173.
# FRONTEND_ORIGINS=https://hoops.example.com

# Rate limits that slow down password guessing (per client address).
# LOGIN_ATTEMPTS=30       # every login try in 5 minutes
# LOGIN_FAILURES=8        # failed logins for one account in 5 minutes
# REGISTER_ATTEMPTS=10    # sign-ups in an hour
