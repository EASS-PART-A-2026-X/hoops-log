# Where the SQLite file lives. Default: ./data/app.db (relative to backend/).
# The app reads the DATABASE_URL environment variable; it does not load this file by itself.
DATABASE_URL=sqlite:///./data/app.db
# Where the AI service listens (only POST /notes/extract uses it). Default: http://localhost:8001
AI_SERVICE_URL=http://localhost:8001
# If the AI service has an AI_SERVICE_TOKEN set, put the same value here. Never commit a real one.
AI_SERVICE_TOKEN=
# How many POST /notes/extract requests are allowed per minute (default 10).
# AI_RATE_LIMIT=10
