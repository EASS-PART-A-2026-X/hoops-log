# Settings for `docker compose up`. Copy to `.env` (git-ignored) only if you want to change one.
# AI_MODEL=test uses the library's fake model: no key, no network, canned answers.
# For a real model:  AI_MODEL=groq:openai/gpt-oss-120b  and set GROQ_API_KEY. NEVER commit a real key.
AI_MODEL=test
GROQ_API_KEY=
# If set, the backend sends it and the AI service requires it (same value for both).
AI_SERVICE_TOKEN=
AI_RATE_LIMIT=10
# The address the BROWSER uses for the backend (baked into the frontend at build time).
VITE_BACKEND_URL=http://localhost:8000
