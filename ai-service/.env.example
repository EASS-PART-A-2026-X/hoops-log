# The Pydantic AI model to use, as "provider:model". The app reads the environment; it
# does not load this file by itself (export the variables or put them in your host's settings).
#   groq:openai/gpt-oss-120b   a real free model (needs GROQ_API_KEY)
#   test                       the library's built-in fake model: no key, no network, canned output
# Leave AI_MODEL unset and /extract answers 503 "No AI model is configured".
# AI_MODEL=test
# If set, /extract needs the same value in the X-Service-Token header (the backend sends it).
# Set it on any public host so strangers cannot spend the model's quota.
# AI_SERVICE_TOKEN=
# Key for the provider named in AI_MODEL (only when it is a real model). NEVER commit a real key.
GROQ_API_KEY=
